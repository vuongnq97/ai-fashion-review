        "url": "={{\n$json.targetJobId\n  ? (\"http://host.docker.internal:3000/api/jobs/\" + $json.targetJobId)\n  : ($('Parse Telegram Message').item.json.targetJobId\n      ? (\"http://host.docker.internal:3000/api/jobs/\" + $('Parse Telegram Message').item.json.targetJobId)\n      : (\"http://host.docker.internal:3000/api/jobs/latest?chatId=\" + $('Parse Telegram Message').item.json.chatId))\n}}",
