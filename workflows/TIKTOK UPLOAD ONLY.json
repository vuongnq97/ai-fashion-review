    {
      "parameters": {
        "jsCode": "const job = $('Validate Job Found').item.json;\n\nfunction getProductsFromNode(nodeName) {\n  try {\n    const data = $(nodeName).first()?.json;\n    if (!data) return [];\n    return Array.isArray(data.products) ? data.products : (Array.isArray(data) ? data : []);\n  } catch (e) {\n    return [];\n  }\n}\n\n// Lấy sản phẩm từ input hiện tại (Page 2 của shop đang chạy)\nconst currentData = $input.item.json;\nconst currentProducts = Array.isArray(currentData.products) ? currentData.products : (Array.isArray(currentData) ? currentData : []);\n\n// Thu thập từ cả Page 1 và Page 2 của tất cả các node affiliate\nconst allProducts = [\n  ...currentProducts,\n  ...getProductsFromNode('Get Link Affiliate'),\n  ...getProductsFromNode('Get Link Affiliate (P2)'),\n  ...getProductsFromNode('Get Link Affiliate (Lady)'),\n  ...getProductsFromNode('Get Link Affiliate (Lady - P2)'),\n  ...getProductsFromNode('Get Link Affiliate (Nhi)'),\n  ...getProductsFromNode('Get Link Affiliate (Nhi - P2)')\n];\n\n// Deduplicate theo product_id\nconst uniqueProducts = [];\nconst seenIds = new Set();\nfor (const p of allProducts) {\n  if (p && p.product_id && !seenIds.has(String(p.product_id))) {\n    seenIds.add(String(p.product_id));\n    uniqueProducts.push(p);\n  }\n}\n\nconst matched = uniqueProducts.find(p => String(p.product_id) === String(job.product?.productId));\n\nconst channelInfo = $('Parse Telegram Message').item.json;\nreturn {\n  json: {\n    jobId: job.jobId,\n    chatId: job.chatId,\n    productId: job.product?.productId,\n    productTitle: matched ? (matched.title || job.product?.title) : (job.product?.title || 'Sản phẩm TikTok Shop'),\n    caption: job.caption || job.product?.title || 'Review sản phẩm #review #tiktokshop',\n    canAttachCart: Boolean(matched),\n    matchedProduct: matched || null,\n    totalProductsFound: uniqueProducts.length,\n    channelId: job.channelId || channelInfo.channelId || 'default',\n    tiktokCredentialId: job.tiktokCredentialId || channelInfo.tiktokCredentialId || 'cJDNuW2i1tFFXivi',\n    tiktokCredentialName: job.tiktokCredentialName || channelInfo.tiktokCredentialName || 'TikTok Credential account'\n  }\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1920,
        250
