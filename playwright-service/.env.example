# Telegram Bot Token (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Server
PORT=3000

# TikTok API Credentials (optional)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://your-domain.github.io/ai-fashion/callback.html

# n8n API Key (optional, only if using n8n workflow)
N8N_API_KEY=your_n8n_api_key

# Gemini Cookie Storage (Single Source of Truth: gemini-cookies/cookies.json)
GEMINI_COOKIE_PATH=./gemini-cookies
GEMINI_WEBAPI_IMPL=node
# Number of panel images to generate in parallel (default = panelCount, i.e. all at once)
# Reduce to 1 if you hit Gemini rate limits frequently.
GEMINI_WEBAPI_PANEL_CONCURRENCY=3
# Timeout per generate request in ms (default 300000 = 5 minutes)
# GEMINI_GENERATE_TIMEOUT_MS=300000

# ── CLI -p mode (node server.js -p 1) ────────────────────────────────────────
# Google Drive folder command mode.
# Put product folders such as p1, p2, m1, m2 directly under this parent folder.
# Telegram commands like /p1 or /m2 will find the matching child folder by name.
GOOGLE_DRIVE_API_KEY=
DRIVE_PARENT_FOLDER_ID=https://drive.google.com/drive/folders/1LDeM0VFPISpzhWLDDAMOYjX4r8sSqqmW

# n8n orchestration mode
N8N_ORCHESTRATION=false
# Set true only when n8n receives Telegram updates directly via Telegram Trigger/webhook.
# Keep false/empty when playwright-service is the Telegram → n8n webhook gateway.
TELEGRAM_POLLING_DISABLED=false
DEFAULT_STORYBOARD_TEMPLATE=template3
GENERATION_JOB_ROOT=

# TikTok Product description image download
PRODUCT_IMAGE_LIMIT=8
PRODUCT_IMAGE_MIN=1
PRODUCT_IMAGE_DOWNLOAD_TIMEOUT_MS=15000
PRODUCT_IMAGE_MAX_BYTES=10485760
# Keep true in normal environments. Set false only when local CA/proxy causes
# SELF_SIGNED_CERT_IN_CHAIN while downloading TikTok image URLs.
PRODUCT_IMAGE_TLS_REJECT_UNAUTHORIZED=true
# Or use a full parent folder URL instead of DRIVE_PARENT_FOLDER_ID:
# DRIVE_PARENT_FOLDER_URL=https://drive.google.com/drive/folders/PARENT_FOLDER_ID

# Optional per-folder override. This still works and takes priority over parent lookup.
# DRIVE_FOLDER_P1=https://drive.google.com/drive/folders/FOLDER_ID
# DRIVE_FOLDER_M2=C:\Users\YourName\Pictures\m2

# Optional local parent directory fallback if no Drive parent is configured.
# Folder commands resolve to child paths like <DRIVE_SYNC_ROOT>\p1 or <DRIVE_SYNC_ROOT>\m2.
DRIVE_SYNC_ROOT=

# Telegram chat ID to send generated videos to when running in -p mode.
# Set this to your personal Telegram chat ID so results are delivered automatically.
DEFAULT_TELEGRAM_CHAT_ID=



# TikTok API Credentials (Sandbox)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# TikTok OAuth
TIKTOK_REDIRECT_URI=https://vuongnq97.github.io/ai-fashion/callback.html

# Server
PORT=3000

# n8n API Key
N8N_API_KEY=your_n8n_api_key

# Playwright Headless mode (true = hide browser window)
HEADLESS=false

# Playwright Browser Window Size (Cấu hình thu nhỏ cửa sổ trình duyệt để không vướng màn hình)
# BROWSER_MINI_WINDOW=true sẽ tự động thu nhỏ cửa sổ về kích thước nhỏ nhất (400x300 px)
# BROWSER_WINDOW_POSITION: 'bottom-left' (mặc định khi bật mini window), 'bottom-right', 'top-left', 'top-right', hoặc 'X,Y' (vd: 0,800)
BROWSER_MINI_WINDOW=false
# BROWSER_WINDOW_POSITION=bottom-left
# BROWSER_WINDOW_WIDTH=400
# BROWSER_WINDOW_HEIGHT=300
# BROWSER_START_MINIMIZED=false

# Telegram Integration (Direct)

# Gemini WebAPI storyboard provider
GEMINI_SECURE_1PSID=your_secure_1psid_cookie
GEMINI_SECURE_1PSIDTS=your_secure_1psidts_cookie
GEMINI_COOKIE_PATH=./gemini-cookies
GEMINI_WEBAPI_IMPL=python
GEMINI_WEBAPI_PANEL_CONCURRENCY=3
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
#ai_review_tikok1_bot
# alternate bot token goes in TELEGRAM_BOT_TOKEN; never commit it here
DEFAULT_TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── CLI -p mode (node server.js -p 1) ─────────────────────────────────────────
# Map each -p number to a Google Drive folder URL or a local path.
# Google Drive URL: DRIVE_FOLDER_P1=https://drive.google.com/drive/folders/FOLDER_ID
# Local path:       DRIVE_FOLDER_P1=C:\Users\YourName\Pictures\p1
# If not set, defaults to ./p{n} relative to playwright-service directory.
DRIVE_FOLDER_P1=https://drive.google.com/drive/folders/FOLDER_ID

# Google Drive API key — required when using Drive folder URLs above.
# Free key, no OAuth needed for publicly shared folders.
# Create at: https://console.cloud.google.com/apis/credentials
# Then enable "Google Drive API" in your project.
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key
DRIVE_PARENT_FOLDER_ID=https://drive.google.com/drive/folders/PARENT_FOLDER_ID
FLOW_MAX_CONCURRENT=3
# Storyboard V2 for template5/template5_1. template5_2 (/t52) is pinned to V1.
STORYBOARD_PIPELINE_VERSION=v1
STORYBOARD_QUALITY_MODE=balanced
STORYBOARD_MAX_PANEL_RETRIES=2
STORYBOARD_MAX_CLIP_RETRIES=2
STORYBOARD_RUN_RETENTION_DAYS=7
STORYBOARD_MIN_IMAGE_SIDE=256
STORYBOARD_JSON_RETRIES=2
# provider = Veo/Flow creates per-scene voice; external_tts = inject synthesizeVoiceover callback.
STORYBOARD_VOICE_STRATEGY=provider
# Optional Unicode font used for deterministic Vietnamese overlays.
# STORYBOARD_FONT_PATH=/absolute/path/to/DejaVuSans.ttf
