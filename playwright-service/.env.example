# Telegram Bot Token (required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Server
PORT=3000

# TikTok API Credentials (optional)
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret
TIKTOK_REDIRECT_URI=https://your-domain.github.io/ai-fashion/callback.html

# n8n API Key (optional, only if using n8n workflow)
N8N_API_KEY=your_n8n_api_key

# Gemini WebAPI storyboard provider (optional)
# Required when config.json systemSettings.storyboardProvider is "gemini-webapi".
GEMINI_SECURE_1PSID=your___Secure-1PSID_cookie
GEMINI_SECURE_1PSIDTS=your___Secure-1PSIDTS_cookie
GEMINI_COOKIE_PATH=./gemini-cookies
# Use HanaokaYuzu/Gemini-API Python bridge by default. Set to "node" to use
# the local JavaScript reverse-engineered client.
GEMINI_WEBAPI_IMPL=python
# Optional if Python is not in PATH. A project-local .venv is preferred when present.
# GEMINI_WEBAPI_PYTHON=C:\Path\To\python.exe
# Number of panel images to generate in parallel (default = panelCount, i.e. all at once)
# Reduce to 1 if you hit Gemini rate limits frequently.
GEMINI_WEBAPI_PANEL_CONCURRENCY=3
# Timeout per generate request in ms (default 300000 = 5 minutes)
# GEMINI_GENERATE_TIMEOUT_MS=300000

# ── CLI -p mode (node server.js -p 1) ────────────────────────────────────────
# Google Drive folder command mode.
# Put product folders such as p1, p2, m1, m2 directly under this parent folder.
# Telegram commands like /p1 or /m2 will find the matching child folder by name.
GOOGLE_DRIVE_API_KEY=
DRIVE_PARENT_FOLDER_ID=https://drive.google.com/drive/folders/1LDeM0VFPISpzhWLDDAMOYjX4r8sSqqmW
# Or use a full parent folder URL instead of DRIVE_PARENT_FOLDER_ID:
# DRIVE_PARENT_FOLDER_URL=https://drive.google.com/drive/folders/PARENT_FOLDER_ID

# Optional per-folder override. This still works and takes priority over parent lookup.
# DRIVE_FOLDER_P1=https://drive.google.com/drive/folders/FOLDER_ID
# DRIVE_FOLDER_M2=C:\Users\YourName\Pictures\m2

# Optional local parent directory fallback if no Drive parent is configured.
# Folder commands resolve to child paths like <DRIVE_SYNC_ROOT>\p1 or <DRIVE_SYNC_ROOT>\m2.
DRIVE_SYNC_ROOT=

# Telegram chat ID to send generated videos to when running in -p mode.
# Set this to your personal Telegram chat ID so results are delivered automatically.
DEFAULT_TELEGRAM_CHAT_ID=



