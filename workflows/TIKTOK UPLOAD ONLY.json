      "parameters": {
        "jsCode": "const data = $json.body || $json;\nconst chatId = String(data.chatId || '');\nconst targetJobId = data.targetJobId || null;\nconst tiktokCredentialId = data.tiktokCredentialId || 'cJDNuW2i1tFFXivi';\nconst tiktokCredentialName = data.tiktokCredentialName || 'TikTok Credential account';\nreturn { json: { route: 'command', command: 'upload', chatId, targetJobId, tiktokCredentialId, tiktokCredentialName, rawText: String(data.text || '/upload') } };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        0
      ],
      "id": "node-parse-telegram",
      "name": "Parse Telegram Message"
    },
    {
