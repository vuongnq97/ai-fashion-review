# ── CLI -p mode (node server.js -p 1) ─────────────────────────────────────────
# Map each -p number to a Google Drive folder URL or a local path.
# Google Drive URL: DRIVE_FOLDER_P1=https://drive.google.com/drive/folders/FOLDER_ID
# Local path:       DRIVE_FOLDER_P1=C:\Users\YourName\Pictures\p1
# If not set, defaults to ./p{n} relative to playwright-service directory.
DRIVE_FOLDER_P1=https://drive.google.com/drive/folders/1y2ZCBLN61oEmGaI5Ke9nnAjywlsoCXEP

# Google Drive API key — required when using Drive folder URLs above.
